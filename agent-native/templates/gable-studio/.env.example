# --- Gable Studio ---
# The studio edits templates/<name>/ in this repo directly and never calls the
# gable ERP, so no GABLE_* (or other APPWRITE_*) vars are needed. The only
# auth var is the JWKS endpoint for Appwrite BYOA (ADR 0002); unset it to use
# the framework's default Better Auth flow in local dev.

# JWKS endpoint of the Appwrite OIDC provider, e.g. https://api.futurebuild.ai/v1/oauth2/jwks
APPWRITE_JWKS_URL=

# --- Classic ERP UI (dual-frontend bridge — docs/steering/dual-frontend-scope.md) ---
# Base URL of the classic gable Lit UI service; enables the classic-link action.
# Local dev: http://localhost:5173 (its Vite proxy must target our backend port)
# CLASSIC_UI_BASE_URL=

# --- Agent engine (LLM) ---
# Skip Builder.io's managed cloud and use YOUR provider key directly
# (Anthropic / OpenAI / Google / OpenRouter via Settings → AI provider).
# Without this, a Builder deploy credential silently wins engine selection
# and chat hands off to Builder.io's cloud.
AGENT_ENGINE_PREFER_BYO_KEY=true

# --- Local dev shortcuts (never in deployed envs) ---
# AUTH_DISABLED=true

# Custom health check message
PING_MESSAGE=pong
